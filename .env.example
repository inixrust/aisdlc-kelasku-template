# Salin ke .env lalu isi. Jangan pernah commit .env.
PORT=3000
DATABASE_PATH=./data/kelasku.db
COOKIE_SECURE=false
NODE_ENV=development
# Hanya dipakai bila NODE_ENV=test (instan ISO UTC, mis. 2026-11-09T03:00:00.000Z)
KELASKU_FAKE_NOW=
# Kredensial admin untuk seed:demo (isi hanya di .env lokal)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
