{
  "name": "kelasku",
  "version": "0.1.0",
  "private": true,
  "description": "Pendaftaran dan kehadiran kelas pelatihan untuk satu lembaga.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && tsc -p tsconfig.server.json && node -e \"const fs = require('node:fs'); fs.rmSync('dist/server/data/migrations', { recursive: true, force: true }); fs.cpSync('src/server/data/migrations', 'dist/server/data/migrations', { recursive: true })\"",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/admin-create.ts",
    "seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
